<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/my_drawer_layout"
    style="@style/parent_drawer"
    tools:context="pbs.sme.survey.activity.RespondentActivity">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:id="@+id/scrollView"
            style="@style/hr_form_scroll">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include layout="@layout/layout_household"/>

                <TextView
                    style="@style/summary_txt_lg"
                    android:layout_width="match_parent"
                    android:text="Respondent Information (Closing)" />

                <LinearLayout
                    style="@style/smp_container_hr"
                    android:orientation="vertical">
                    <LinearLayout
                        style="@style/vliner">
                        <TextView
                            style="@style/q_heading"
                            android:text="Designation of the Respondent (*): "/>
                        <RelativeLayout
                            style="@style/vertical_wrapper"
                            android:background="@drawable/spinner_container">
                            <Spinner
                                android:id="@+id/designation"
                                style="@style/spn_form"
                                android:entries="@array/spn_desig"/>
                        </RelativeLayout>

                    </LinearLayout>
                    <LinearLayout
                        style="@style/vliner">
                        <TextView
                            style="@style/q_heading"
                            android:text="Name of the Respondent (*): "/>
                        <EditText
                            android:id="@+id/name"
                            style="@style/edit_form_text"/>
                    </LinearLayout>
                    <LinearLayout
                        style="@style/vliner">
                        <TextView
                            style="@style/q_heading"
                            android:text="Interview Status (*): "/>
                        <RelativeLayout
                            style="@style/vertical_wrapper"
                            android:background="@drawable/spinner_container">
                            <Spinner
                                android:id="@+id/interview_status"
                                style="@style/spn_form"
                                android:entries="@array/spn_interview"/>
                        </RelativeLayout>
                    </LinearLayout>
                    <LinearLayout
                        style="@style/vliner">
                        <TextView
                            style="@style/q_heading"
                            android:text="Behaviour of Respondent (*): "/>
                        <RelativeLayout
                            style="@style/vertical_wrapper"
                            android:background="@drawable/spinner_container">
                            <Spinner
                                android:id="@+id/respondent_behaviour"
                                style="@style/spn_form"
                                android:entries="@array/spn_behaviour"/>
                        </RelativeLayout>

                    </LinearLayout>

                    <LinearLayout
                        style="@style/vliner">
                        <TextView
                            style="@style/q_heading"
                            android:text="Remarks (Optional): "/>
                        <EditText
                            android:id="@+id/remarks"
                            style="@style/edit_form_text"/>
                    </LinearLayout>
                </LinearLayout>
                <include layout="@layout/layout_form_buttons"/>
                </LinearLayout>

        </ScrollView>


        <include
            android:id="@+id/footer"
            layout="@layout/footer"/>
    </RelativeLayout>

    <include layout="@layout/layout_nav"/>
</androidx.drawerlayout.widget.DrawerLayout>