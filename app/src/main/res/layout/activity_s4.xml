<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/parent_drawer"
    tools:context="pbs.sme.survey.activity.S3Activity">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:id="@+id/scrollView"
            style="@style/hr_form_scroll">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include layout="@layout/layout_household"/>

                <TextView
                    style="@style/summary_txt_lg"
                    android:layout_width="match_parent"
                    android:text="Section-4: Output Excluding Sales Tax (FY 2023-2024) (Last 3 Months)" />

                <LinearLayout
                    style="@style/smp_container_hr"
                    android:orientation="vertical">
                    <LinearLayout
                        style="@style/smp_container_hr"
                        android:weightSum="10"
                        android:paddingVertical="?pad"
                        android:background="?s_color">
                        <TextView
                            style="@style/summary_eng"
                            android:layout_weight="1.2"
                            android:textColor="@color/white"
                            android:text="Code"
                            android:gravity="center_horizontal"/>
                        <TextView
                            style="@style/summary_eng"
                            android:layout_weight="6.8"
                            android:text="Description"
                            android:textColor="@color/white"
                            android:gravity="left"/>
                        <TextView
                            style="@style/summary_eng"
                            android:layout_weight="2"
                            android:textColor="@color/white"
                            android:text="Value"/>
                    </LinearLayout>
                    <LinearLayout
                        style="@style/hliner"
                        android:weightSum="10">
                        <TextView
                            style="@style/summary_eng_c"
                            android:text="401"/>
                        <TextView
                            style="@style/summary_eng"
                            android:text="Value of sales of finished /Semi finished goods" />
                        <EditText
                            android:id="@+id/value__401"
                            style="@style/edit_table_num"/>
                    </LinearLayout>
                    <LinearLayout
                        style="@style/hliner"
                        android:weightSum="10">
                        <TextView
                            style="@style/summary_eng_c"
                            android:text="402"/>
                        <TextView
                            style="@style/summary_eng"
                            android:text="Value of goods/fixed assets produced and consumed by establishment" />
                        <EditText
                            android:id="@+id/value__402"
                            style="@style/edit_table_num"/>
                    </LinearLayout>
                    <LinearLayout
                        style="@style/hliner"
                        android:weightSum="10">
                        <TextView
                            style="@style/summary_eng_c"
                            android:text="403"/>
                        <TextView
                            style="@style/summary_eng"
                            android:text="Receipt from work done for others" />
                        <EditText
                            android:id="@+id/value__403"
                            style="@style/edit_table_num"/>
                    </LinearLayout>
                    <LinearLayout
                        style="@style/hliner"
                        android:weightSum="10">
                        <TextView
                            style="@style/summary_eng_c"
                            android:text="404"/>
                        <TextView
                            style="@style/summary_eng"
                            android:text="Income from sales from goods/material that is purchase for resale without further processing" />
                        <EditText
                            android:id="@+id/value__404"
                            style="@style/edit_table_num"/>
                    </LinearLayout>
                    <LinearLayout
                        style="@style/hliner"
                        android:weightSum="10">
                        <TextView
                            style="@style/summary_eng_c"
                            android:text="405"/>
                        <TextView
                            style="@style/summary_eng"
                            android:text="Income from scrap, electricity, waste product etc" />
                        <EditText
                            android:id="@+id/value__405"
                            style="@style/edit_table_num"/>
                    </LinearLayout>
                    <LinearLayout
                        style="@style/hliner"
                        android:weightSum="10">
                        <TextView
                            style="@style/summary_eng_c"
                            android:text="406"/>
                        <TextView
                            style="@style/summary_eng"
                            android:text="Other revenues n.e.c" />
                        <EditText
                            android:id="@+id/value__406"
                            style="@style/edit_table_num"/>
                    </LinearLayout>
                    <LinearLayout
                        style="@style/hliner"
                        android:weightSum="10">
                        <TextView
                            style="@style/summary_eng_c"
                            android:text="400"/>
                        <TextView
                            style="@style/summary_eng"
                            android:text="Total" />
                        <EditText
                            android:id="@+id/value__400"
                            android:enabled="false"
                            android:background="@drawable/bg_disabled"
                            style="@style/edit_table_num"/>
                    </LinearLayout>
                    <LinearLayout
                        style="@style/hliner"
                        android:weightSum="10">
                        <TextView
                            style="@style/summary_eng_c"
                            android:text="408"/>
                        <TextView
                            style="@style/summary_eng"
                            android:textColor="@color/red"
                            android:text="Revenue/ Income via own website, Domestic DIPs, International DIPs  (% of total)" />
                        <EditText
                            android:id="@+id/value__408"
                            android:maxLength="2"
                            style="@style/edit_table_num"/>
                    </LinearLayout>


                    <include layout="@layout/layout_form_buttons"/>
                    <LinearLayout
                        style="@style/vertical_wrapper">
                        <LinearLayout
                            android:layout_marginVertical="?pad"
                            style="@style/hliner"
                            android:weightSum="12">
                            <TextView
                                style="@style/num_1w"
                                android:text="Type"
                                android:layout_weight="2"/>
                            <TextView
                                style="@style/num_1w"
                                android:text="Billion"
                                android:textColor="@color/red"
                                android:layout_weight="2"/>
                            <TextView
                                style="@style/num_1w"
                                android:text="Million"
                                android:textColor="@color/settGreen"
                                android:layout_weight="3"/>
                            <TextView
                                style="@style/num_1w"
                                android:text="Hundered"
                                android:textColor="@color/color_blue"
                                android:layout_weight="3"/>
                            <TextView
                                style="@style/num_1w"
                                android:text="0"/>
                            <TextView
                                style="@style/num_1w"
                                android:text="0" />

                        </LinearLayout>
                        <LinearLayout
                            android:layout_marginVertical="?pad"
                            style="@style/hliner"
                            android:background="@color/grey"
                            android:weightSum="12">
                            <TextView
                                style="@style/num_1w"
                                android:layout_weight="2"
                                android:text="Input"/>
                            <TextView
                                android:id="@+id/input__10"
                                style="@style/num_1w"
                                android:textColor="@color/red"
                                android:text=""/>
                            <TextView
                                android:id="@+id/input__9"
                                style="@style/num_1w"
                                android:textColor="@color/red"
                                android:text="" />
                            <TextView
                                android:id="@+id/input__8"
                                style="@style/num_1w"
                                android:textColor="@color/settGreen"
                                android:text=""/>
                            <TextView
                                android:id="@+id/input__7"
                                style="@style/num_1w"
                                android:textColor="@color/settGreen"
                                android:text="" />
                            <TextView
                                android:id="@+id/input__6"
                                style="@style/num_1w"
                                android:textColor="@color/settGreen"
                                android:text=""/>
                            <TextView
                                android:id="@+id/input__5"
                                style="@style/num_1w"
                                android:textColor="@color/color_blue"
                                android:text="" />
                            <TextView
                                android:id="@+id/input__4"
                                style="@style/num_1w"
                                android:textColor="@color/color_blue"
                                android:text=""/>
                            <TextView
                                android:id="@+id/input__3"
                                style="@style/num_1w"
                                android:textColor="@color/color_blue"
                                android:text="" />
                            <TextView
                                android:id="@+id/input__2"
                                style="@style/num_1w"
                                android:text=""/>
                            <TextView
                                android:id="@+id/input__1"
                                style="@style/num_1w"
                                android:text="" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_marginVertical="?pad"
                            style="@style/hliner"
                            android:background="@color/grey"
                            android:weightSum="12">
                            <TextView
                                style="@style/num_1w"
                                android:layout_weight="2"
                                android:text="Output"/>
                            <TextView
                                android:id="@+id/output__10"
                                style="@style/num_1w"
                                android:textColor="@color/red"
                                android:text=""/>
                            <TextView
                                android:id="@+id/output__9"
                                style="@style/num_1w"
                                android:textColor="@color/red"
                                android:text="" />
                            <TextView
                                android:id="@+id/output__8"
                                style="@style/num_1w"
                                android:textColor="@color/settGreen"
                                android:text=""/>
                            <TextView
                                android:id="@+id/output__7"
                                style="@style/num_1w"
                                android:textColor="@color/settGreen"
                                android:text="" />
                            <TextView
                                android:id="@+id/output__6"
                                style="@style/num_1w"
                                android:textColor="@color/settGreen"
                                android:text=""/>
                            <TextView
                                android:id="@+id/output__5"
                                style="@style/num_1w"
                                android:textColor="@color/color_blue"
                                android:text="" />
                            <TextView
                                android:id="@+id/output__4"
                                style="@style/num_1w"
                                android:textColor="@color/color_blue"
                                android:text=""/>
                            <TextView
                                android:id="@+id/output__3"
                                style="@style/num_1w"
                                android:textColor="@color/color_blue"
                                android:text="" />
                            <TextView
                                android:id="@+id/output__2"
                                style="@style/num_1w"
                                android:text=""/>
                            <TextView
                                android:id="@+id/output__1"
                                style="@style/num_1w"
                                android:text="" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_marginVertical="?pad"
                            style="@style/hliner"
                            android:background="@color/grey"
                            android:weightSum="12">
                            <TextView
                                android:id="@+id/balance"
                                style="@style/num_1w"
                                android:layout_weight="2"
                                android:text="Balance"/>
                            <TextView
                                android:id="@+id/balance__10"
                                style="@style/num_1w"
                                android:textColor="@color/red"
                                android:text=""/>
                            <TextView
                                android:id="@+id/balance__9"
                                style="@style/num_1w"
                                android:textColor="@color/red"
                                android:text="" />
                            <TextView
                                android:id="@+id/balance__8"
                                style="@style/num_1w"
                                android:textColor="@color/settGreen"
                                android:text=""/>
                            <TextView
                                android:id="@+id/balance__7"
                                style="@style/num_1w"
                                android:textColor="@color/settGreen"
                                android:text="" />
                            <TextView
                                android:id="@+id/balance__6"
                                style="@style/num_1w"
                                android:textColor="@color/settGreen"
                                android:text=""/>
                            <TextView
                                android:id="@+id/balance__5"
                                style="@style/num_1w"
                                android:textColor="@color/color_blue"
                                android:text="" />
                            <TextView
                                android:id="@+id/balance__4"
                                style="@style/num_1w"
                                android:textColor="@color/color_blue"
                                android:text=""/>
                            <TextView
                                android:id="@+id/balance__3"
                                style="@style/num_1w"
                                android:textColor="@color/color_blue"
                                android:text="" />
                            <TextView
                                android:id="@+id/balance__2"
                                style="@style/num_1w"
                                android:text=""/>
                            <TextView
                                android:id="@+id/balance__1"
                                style="@style/num_1w"
                                android:text="" />

                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </ScrollView>


        <include
            android:id="@+id/footer"
            layout="@layout/footer"/>
    </RelativeLayout>

    <include layout="@layout/layout_nav"/>
</androidx.drawerlayout.widget.DrawerLayout>